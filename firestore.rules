
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // En entorno de desarrollo/emulador permitimos todo
      // En producción deberías restringir a: allow read, write: if request.auth != null;
      allow read, write: if true;
    }

    // Activity history, session summaries and global settings are always
    // scoped to their owner. These rules take effect once the catch-all above
    // is tightened for production.
    match /users/{userId}/settings/main {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/activity/{eventId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
