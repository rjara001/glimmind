# Cloud Functions environment — non-secret values only.
#
# Do NOT put STRIPE_SECRET_KEY, STRIPE_PRICE_ID or STRIPE_WEBHOOK_SECRET here.
# The Stripe routes declare them as secrets, and firebase-tools injects this file
# as PLAIN env vars on deploy. A plain var colliding with a declared secret
# fails the whole deploy with:
#   "Secret environment variable overlaps non secret environment variable"
#
# Stripe credentials live in GCP Secret Manager. The Functions emulator resolves
# declared secrets from there too, so local and production read the same values:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_PRICE_ID
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# Current values are SANDBOX (sk_test_). See the comment block at the top of
# src/routes/stripeRoutes.js before rotating anything.

DEEPL_API_KEY=
# FIRESTORE_EMULATOR_HOST is set dynamically via firebase.js based on FUNCTIONS_EMULATOR flag