# Cloud Functions environment — Stripe SANDBOX (test mode only).
# Copy to `.env` and fill in real values. This is the ONLY place Stripe
# credentials live: the Stripe functions deliberately do not declare
# `secrets: [...]` in onRequest, because a declared secret makes the Functions
# emulator fetch it from GCP Secret Manager (which holds a live key) and ignore
# this file. One file, and the emulator cannot reach production.
#
# A deployed function no longer receives these from Secret Manager. If billing
# goes live, redeclare the secrets AND add `.secret.local` for local work, in
# the same change. See the comment at the top of src/routes/stripeRoutes.js.
#
# Test mode keys come from https://dashboard.stripe.com/test/apikeys
# Every key below MUST start with the test prefix. stripeConfig.js throws on
# any sk_live_ / rk_live_ value, so production cannot be reached from this
# integration.

DEEPL_API_KEY=
# FIRESTORE_EMULATOR_HOST is set dynamically via firebase.js based on FUNCTIONS_EMULATOR flag

# Secret API key, test mode. Must start with sk_test_.
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook signing secret. Must start with whsec_.
# Get it from `stripe listen`, which prints e.g.:
#   stripe listen --forward-to localhost:9001/fladycard-22a3e/us-central1/stripeWebhook
#   --> Ready! Your webhook signing secret is whsec_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Recurring monthly price in test mode.
# Stripe dashboard > Products > Pricing > copy the price ID (starts with price_).
# There is no fallback literal on purpose: a hardcoded price ID cannot be
# verified as test mode.
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXX