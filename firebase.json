{
  "functions": {
    "source": "backend/src/functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "app/**",
      "lib/**",
      "backend/**",
      "src/**"
    ],
    "headers": [
      {
        "source": "/models/**/*.tar.gz",
        "headers": [
          {
            "key": "Content-Encoding",
            "value": "identity"
          },
          {
            "key": "Content-Type",
            "value": "application/gzip"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "single_project_mode": true
  }
}