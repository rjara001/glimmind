{
  "functions": {
    "source": "backend/src/functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "app/**",
      "lib/**",
      "backend/**",
      "src/**"
    ],
    "headers": [
      {
        "source": "/models/**/*.tar.gz",
        "headers": [
          {
            "key": "Content-Encoding",
            "value": "identity"
          },
          {
            "key": "Content-Type",
            "value": "application/gzip"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "microphone=(), camera=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.tailwindcss.com https://esm.sh https://www.gstatic.com https://apis.google.com https://identitytoolkit.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' data: https://esm.sh https://identitytoolkit.googleapis.com https://firestore.googleapis.com https://firebasestorage.googleapis.com https://*.googleapis.com https://*.google.com https://*.cloudfunctions.net https://generativelanguage.googleapis.com https://api-free.deepl.com https://texttospeech.googleapis.com https://speech.googleapis.com wss://*.googleapis.com; frame-src 'self' https://www.google.com https://apis.google.com https://identitytoolkit.googleapis.com; worker-src 'self' blob: data:;"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/getProgress",
        "function": "getProgress"
      },
      {
        "source": "/api/getSettings",
        "function": "getSettings"
      },
      {
        "source": "/api/updateSettings",
        "function": "updateSettings"
      },
      {
        "source": "/api/updateProgress",
        "function": "updateProgress"
      },
      {
        "source": "/api/updateList",
        "function": "updateList"
      },
      {
        "source": "/api/updateListFields",
        "function": "updateListFields"
      },
      {
        "source": "/api/deleteList",
        "function": "deleteList"
      },
      {
        "source": "/api/appendActivity",
        "function": "appendActivity"
      },
      {
        "source": "/api/saveSession",
        "function": "saveSession"
      },
      {
        "source": "/api/synthesizeSpeech",
        "function": "synthesizeSpeech"
      },
      {
        "source": "/api/deleteUserAccount",
        "function": "deleteUserAccount"
      },
      {
        "source": "/api/exportUserData",
        "function": "exportUserData"
      },
      {
        "source": "/api/getActivity",
        "function": "getActivity"
      },
      {
        "source": "/api/getSessions",
        "function": "getSessions"
      },
      {
        "source": "/api/aiGroup",
        "function": "aiGroup"
      },
      {
        "source": "/api/submitDeckToCatalog",
        "function": "submitDeckToCatalog"
      },
      {
        "source": "/api/moderateDeckPreview",
        "function": "moderateDeckPreview"
      },
      {
        "source": "/api/createDeckFromText",
        "function": "createDeckFromText"
      },
      {
        "source": "/api/getPrebuiltDecks",
        "function": "getPrebuiltDecks"
      },
      {
        "source": "/api/getLists",
        "function": "getLists"
      },
      {
        "source": "/api/createList",
        "function": "createList"
      },
      {
        "source": "/api/getList",
        "function": "getList"
      },
      {
        "source": "/api/splitList",
        "function": "splitList"
      },
      {
        "source": "/api/transcribeSpeech",
        "function": "transcribeSpeech"
      },
      {
        "source": "/api/transcribeExistingAudio",
        "function": "transcribeExistingAudio"
      },
      {
        "source": "/api/transcribeChirp3",
        "function": "transcribeChirp3"
      },
      {
        "source": "/api/translateVocabulary",
        "function": "translateVocabulary"
      },
      {
        "source": "/api/listTtsVoices",
        "function": "listTtsVoices"
      },
      {
        "source": "/api/getQuota",
        "function": "getQuota"
      },
      {
        "source": "/api/getDashboardData",
        "function": "getDashboardData"
      },
      {
        "source": "/api/setUserQuota",
        "function": "setUserQuota"
      },
      {
        "source": "/api/setUserPremium",
        "function": "setUserPremium"
      },
      {
        "source": "/api/getAdminUsage",
        "function": "getAdminUsage"
      },
      {
        "source": "/api/createYouTubeDeck",
        "function": "createYouTubeDeck"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001,
      "env": {
        "FIRESTORE_EMULATOR_HOST": "localhost:8080"
      }
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "single_project_mode": true
  }
}