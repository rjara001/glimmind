# Frontend (Vite) environment — Stripe SANDBOX / test mode only.
# Copy to `.env.local` and fill in real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_USE_EMULATORS=true
VITE_USE_CLEAN_URLS=false
VITE_ENABLE_WIDGET=false

# Leave empty to call Cloud Functions through Firebase Hosting rewrites
# (/api/*). Set to the functions origin when calling them directly.
VITE_FUNCTIONS_BASE=

# Stripe publishable key, TEST MODE ONLY. Must start with pk_test_.
# Source: https://dashboard.stripe.com/test/apikeys
# Safe to expose in the browser bundle, but never ship a pk_live_ value here:
# the whole billing flow is wired to the sandbox.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX